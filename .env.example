# Pinecone Serverless Free-Tier Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=hybrid-ai-engine
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Vector Embedding Configuration
EMBEDDING_DIMENSION=384
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional LLM Key
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Classical ML Settings
MIN_SAMPLES_TO_TRAIN=100
MODEL_ARTIFACTS_DIR=artifacts/models
DATA_STORAGE_DIR=artifacts/data

# FastAPI Server
HOST=127.0.0.1
PORT=8000
DEBUG=True
